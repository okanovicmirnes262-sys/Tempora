# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # "anon" / "publishable" ključ
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # "service_role" / "secret" ključ — NIKAD ne dijeli

# Push obavijesti: generiraj s `npm run vapid`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tvoj@email.com
